# ===== FlowSync server configuration (copy to server/.env) =====
# REQUIRED
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowsync?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Optional (safe development defaults)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
# Optional test database (integration tests are skipped when unset)
MONGODB_URI_TEST=
# ===== Not implemented yet (reserved for later phases) =====
# EMAIL_PROVIDER_API_KEY=
# CLOUDINARY_URL=
# AI_PROVIDER_API_KEY=

# ===== FlowSync client configuration (copy to client/.env) =====
# VITE_API_URL=http://localhost:5000
